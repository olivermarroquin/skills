{
  "_comment": "Schema-sync profile for S&H Contracting Unlimited. Used by schema_sync_engine.py.",
  "client_slug": "s-and-h-contracting",

  "wordpress": {
    "domain": "shcontractingunlimited.com",
    "api_user": "oliver@keelworks.ai",
    "api_password_env": "WP_APP_PASSWORD_SH",
    "seo_plugin": "yoast"
  },

  "schema_config": {
    "business_type_schema": "LocalBusiness",
    "canonical_business_id": "https://shcontractingunlimited.com/#business",

    "howto_step_selectors": [
      {
        "_comment": "S&H process-step pattern — same evp- design system as EV (shared design system)",
        "combined_pattern": "evp-step-badge[^>]*>(\\d+)</div>.*?<h3[^>]*>(.*?)</h3>.*?<p[^>]*>(.*?)</p>"
      }
    ],

    "speakable_css_selectors": [
      ".evp-faq-list",
      ".evp-process-list",
      ".evp-hero-content h1",
      ".evp-section h2"
    ],

    "skip_widget_patterns": ["ti-review-*"]
  },

