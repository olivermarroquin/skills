    {
      "step": "aggregate_rating_read",
      "description": "Read the CURRENT Google review count + rating from the live GBP listing for S&H Contracting Unlimited. GBP is not headless-fetchable.",
      "output_needed": "--rating <value> --count <value> args for the sync-rating command"
    },
    {
      "step": "keelworks_jsonld_head_plugin_install",
      "description": "The keelworks-jsonld-head plugin must be installed on shcontractingunlimited.com. Upload via WP Admin > Plugins > Add New > Upload Plugin.",
      "prerequisite_for": "inject-lb command (Elementor pages)"
    },
    {
      "step": "wp_page_ids",
      "description": "S&H page WP IDs are not yet populated in this profile. Run: curl -s -u user:pass 'https://shcontractingunlimited.com/wp-json/wp/v2/pages?per_page=100&_fields=id,slug' to get them, then update this profile.",
